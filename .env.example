# Dane logowania Librus (wymagane)
LIBRUS_USERNAME=your_username
LIBRUS_PASSWORD=your_password

# OpenAI API (wymagane)
OPENAI_API_KEY=your_openai_api_key

# Konfiguracja e-mail
SEND_EMAIL=false
EMAIL_HOST=smtp.fastmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Librus Notifications <notifications@example.com>
EMAIL_TO=recipient1@example.com,recipient2@example.com

# Ustawienia opcjonalne
LOG_LEVEL=INFO
DB_PATH=./librus.db

# Vikunja (opcjonalne) — zadania wymagające działania trafiają do wskazanego projektu
# VIKUNJA_URL=https://tasks.example.com
# VIKUNJA_USERNAME=bot
# VIKUNJA_PASSWORD=your_password
# VIKUNJA_PROJECT_ID=29

# Google Calendar (opcjonalne) — patrz README: Uwagi i terminarz
# GOOGLE_CALENDAR_ID=identyfikator_kalendarza
# GOOGLE_CALENDAR_CREDENTIALS_FILE=/sciezka/do/powiadczen.json
